# ==============================================================================
# Environment Configuration Template for Digital Marketing AI Agent
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# General Application Settings
ENVIRONMENT=development
PROJECT_NAME="Digital Marketing AI Agent"
PUBLIC_SERVER_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/poster_studio

# Cloudflare Workers AI (LLaMA 3.2 Vision, FLUX.1 Schnell)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Google Gemini API (Multimodal Reasoning & Fallback Directing)
GEMINI_API_KEY=your_gemini_api_key

# Storage Backend (local or r2)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=Backend/storage

# Cloudflare R2 Bucket (Optional - for production cloud storage)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_BASE_URL=https://your-bucket-url.com

# Hugging Face API Token (Wan 2.2 / Fast Diffusion Video Synthesis)
HUGGING_FACE_TOKEN=your_hugging_face_token

# Firecrawl / Web Retrieval
FILECRAWLER_API_KEY=your_firecrawl_api_key

# Pinecone Vector Database (Knowledge Graph & Dynamic RAG)
PINECONE_API_KEY=your_pinecone_api_key

# JWT Security
JWT_SECRET_KEY=your_super_secret_jwt_random_key_here

# Social Publishing Integrations (LinkedIn)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5173/auth/linkedin/callback
LINKEDIN_ACCESS_TOKEN=your_linkedin_user_token
LINKEDIN_AUTHOR_URN=urn:li:person:your_urn

# Social Publishing Integrations (Instagram Graph API)
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
